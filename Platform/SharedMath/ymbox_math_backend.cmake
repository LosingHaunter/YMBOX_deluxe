# Board-side integration, for example:
# include(path/to/Platform/SharedMath/ymbox_math_backend.cmake)
# ymbox_link_shared_math(firmware SINCOS LUT ATAN LUT SQRT GENERIC)
# With no explicit backend arguments, read the saved calculator config.
# CONFIGURATION path/to/export.json selects another export.
#
# Do not also compile the same backend sources from an IDE wildcard group.
function(_ymbox_read_configuration file output)
    if(NOT "${file}" MATCHES "\\.[jJ][sS][oO][nN]$")
        message(FATAL_ERROR "YMBOX configuration must be a JSON file: ${file}")
    endif()
    file(READ "${file}" _text)
    set(${output} "${_text}" PARENT_SCOPE)
endfunction()

function(ymbox_link_shared_math target)
    set(_YMBOX_PLATFORM_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    cmake_parse_arguments(YMATH "" "SINCOS;ATAN;SQRT;CONFIGURATION;CONTROL_ANGLE_COUNTS" "" ${ARGN})
    if(NOT TARGET ${target})
        message(FATAL_ERROR "ymbox_link_shared_math requires an existing firmware target")
    endif()
    get_property(_already_set TARGET ${target} PROPERTY YMBOX_MATH_BACKENDS_LINKED)
    if(_already_set)
        message(FATAL_ERROR "YMBOX math backends have already been linked to ${target}")
    endif()
    if(YMATH_UNPARSED_ARGUMENTS OR YMATH_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Unknown YMBOX math arguments: ${YMATH_UNPARSED_ARGUMENTS}")
    endif()
    set(_default_SINCOS LUT)
    set(_default_ATAN LUT)
    set(_default_SQRT GENERIC)
    set(_default_counts 4096)
    if(YMATH_CONFIGURATION)
        get_filename_component(_configuration "${YMATH_CONFIGURATION}" ABSOLUTE)
        if(NOT EXISTS "${_configuration}")
            message(FATAL_ERROR "YMBOX math configuration does not exist: ${_configuration}")
        endif()
    else()
        set(_configuration "${_YMBOX_PLATFORM_ROOT}/../ProjectConfiguration/ApplicationParameters/YMBOX_ActiveConfiguration.json")
        if(NOT EXISTS "${_configuration}")
            message(FATAL_ERROR "Calculator parameter file is missing: ${_configuration}. Write it in the YMBOX calculator first.")
        endif()
    endif()
    if(EXISTS "${_configuration}")
        if(CMAKE_VERSION VERSION_LESS "3.19")
            message(FATAL_ERROR "Reading YMBOX configuration JSON requires CMake 3.19 or newer")
        endif()
        _ymbox_read_configuration("${_configuration}" _configuration_json)
        string(JSON _root_type ERROR_VARIABLE _json_error TYPE "${_configuration_json}")
        if(_json_error OR NOT _root_type STREQUAL "OBJECT")
            message(FATAL_ERROR "Invalid YMBOX configuration JSON: ${_configuration}")
        endif()
        string(JSON _counts ERROR_VARIABLE _counts_error GET "${_configuration_json}" drive PositionSensor ControlAngleCounts)
        if(NOT _counts_error)
            if(NOT "${_counts}" MATCHES "^(4096|8192)$")
                message(FATAL_ERROR "ControlAngleCounts must be 4096 or 8192")
            endif()
            set(_default_counts "${_counts}")
        endif()
        string(JSON _math_type ERROR_VARIABLE _math_error TYPE "${_configuration_json}" drive PlatformMath)
        if(NOT _math_error)
            if(NOT _math_type STREQUAL "OBJECT")
                message(FATAL_ERROR "drive.PlatformMath must be an object")
            endif()
            set(_key_SINCOS SinCosBackend)
            set(_key_ATAN AtanBackend)
            set(_key_SQRT SqrtBackend)
            foreach(_service SINCOS ATAN SQRT)
                string(JSON _value ERROR_VARIABLE _value_error GET "${_configuration_json}" drive PlatformMath ${_key_${_service}})
                if(_value_error)
                    message(FATAL_ERROR "Missing YMBOX math setting: ${_key_${_service}}")
                endif()
                set(_default_${_service} "${_value}")
            endforeach()
        endif()
        # Reconfigure the target when a new calculator configuration is applied.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_configuration}")
    endif()
    if(NOT DEFINED YMATH_CONTROL_ANGLE_COUNTS)
        set(YMATH_CONTROL_ANGLE_COUNTS "${_default_counts}")
    endif()
    if(NOT "${YMATH_CONTROL_ANGLE_COUNTS}" MATCHES "^(4096|8192)$")
        message(FATAL_ERROR "CONTROL_ANGLE_COUNTS must be 4096 or 8192")
    endif()
    # One full electrical turn has N control counts and N SinCos LUT segments.
    # Only one quarter-wave table is compiled into the selected LUT backend.
    target_compile_definitions(${target} PRIVATE MDSA_SINCOS_LUT_COUNTS=${YMATH_CONTROL_ANGLE_COUNTS})
    set_property(TARGET ${target} PROPERTY YMBOX_MATH_CONTROL_ANGLE_COUNTS "${YMATH_CONTROL_ANGLE_COUNTS}")
    set(_hardware_families "")
    foreach(_service SINCOS ATAN SQRT)
        if(NOT YMATH_${_service})
            set(YMATH_${_service} "${_default_${_service}}")
        endif()
        string(TOUPPER "${YMATH_${_service}}" _backend)
        if(_service STREQUAL "SQRT")
            set(_allowed "^(GENERIC|TI_TMU|STM32_FPU)$")
        else()
            set(_allowed "^(LUT|GENERIC|TRICORE|TI_TMU|STM32_CORDIC)$")
        endif()
        if(NOT _backend MATCHES "${_allowed}")
            message(FATAL_ERROR "Unsupported ${_service} backend: ${_backend}")
        endif()
        if(_backend MATCHES "^STM32_")
            list(APPEND _hardware_families STM32)
        elseif(_backend STREQUAL "TI_TMU")
            list(APPEND _hardware_families TI)
        elseif(_backend STREQUAL "TRICORE")
            list(APPEND _hardware_families TRICORE)
        endif()
        set_property(TARGET ${target} PROPERTY YMBOX_MATH_${_service}_BACKEND "${_backend}")
        string(TOLOWER "${_backend}" _backend)
        if(_service STREQUAL "SINCOS")
            target_sources(${target} PRIVATE
                "${_YMBOX_PLATFORM_ROOT}/SinCos/mdsa_sincos_${_backend}.c")
        elseif(_service STREQUAL "ATAN")
            target_sources(${target} PRIVATE
                "${_YMBOX_PLATFORM_ROOT}/Atan/ymbox_atan_${_backend}.c")
        else()
            target_sources(${target} PRIVATE
                "${_YMBOX_PLATFORM_ROOT}/Sqrt/ymbox_sqrt_${_backend}.c")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _hardware_families)
    list(LENGTH _hardware_families _family_count)
    if(_family_count GREATER 1)
        message(FATAL_ERROR "YMBOX math implementations cannot mix STM32, TI and TriCore targets")
    endif()
    target_sources(${target} PRIVATE
        "${_YMBOX_PLATFORM_ROOT}/SharedMath/ymbox_math_init.c"
        "${_YMBOX_PLATFORM_ROOT}/SharedMath/ymbox_scalar_math_f32.c")
    # The model retains / operators. The code replacement expands this
    # hardware mapping inline and never calls an out-of-line divide service.
    if("TI" IN_LIST _hardware_families)
        target_compile_definitions(${target} PRIVATE YMBOX_TMU_DIVISION=1)
    else()
        target_compile_definitions(${target} PRIVATE YMBOX_TMU_DIVISION=0)
    endif()
    target_include_directories(${target} PRIVATE
        "${_YMBOX_PLATFORM_ROOT}/SharedMath"
        "${_YMBOX_PLATFORM_ROOT}/SinCos"
        "${_YMBOX_PLATFORM_ROOT}/Atan"
        "${_YMBOX_PLATFORM_ROOT}/Sqrt")
    set_property(TARGET ${target} PROPERTY YMBOX_MATH_BACKENDS_LINKED TRUE)
endfunction()
